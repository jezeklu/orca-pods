# Server: cp server.env.example ~/.config/orca-pods/server.env
# The only host path orca-pods passes into the container. Must be a local file system with ACL support.
PODS_SECRETS_DIR="$HOME/.local/share/orca-pods/secrets"
# Runtimes next to the image Node, installed by mise into the container home. Projects pick them by
# .nvmrc, .node-version, .tool-versions or mise.toml.
#PODS_RUNTIMES="node@24 python@3.13"
# Optional tools installed into the container home at start, off by default. Supported: agy (Antigravity CLI), openspec (OpenSpec CLI).
#PODS_TOOLS="agy openspec"
# Port on 127.0.0.1 for a local Orca.
#PODS_PORT=6769
#PODS_MEMORY=10g
# Rootless Podman and a Docker API inside the server, off by default. Needs more subordinate IDs on
# the host, run doctor first. See "Containers inside the server" in the README.
#PODS_CONTAINERS=1
