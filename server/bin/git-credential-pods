#!/bin/sh
# Picks the GitHub token by repository owner. Git asks with useHttpPath, so the path is known.
[ "${1:-}" = get ] || exit 0
host=""; path=""
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  case "$key" in
    host) host=$value ;;
    path) path=$value ;;
  esac
done
[ "$host" = github.com ] || exit 0
owner=$(printf '%s' "${path%%/*}" | tr 'A-Z' 'a-z')
case "$owner" in ""|*[!a-z0-9-]*) exit 0 ;; esac
file=/secrets/github/$owner.token
[ -r "$file" ] || exit 0
echo "username=x-access-token"
echo "password=$(cat "$file")"
