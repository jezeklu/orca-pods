#!/bin/bash
# Keeps Orca running as dev. Xvfb stays while serve is replaced, so an update does not touch it.
set -u
APP=$HOME/.local/share/orca-server
RUN=/tmp/orca-serve
mkdir -p "$RUN"
chmod 700 "$RUN"
Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp &
export DISPLAY=:99

serve() {
  dbus-run-session -- "$APP/current/AppRun" --no-sandbox serve --port 6768 --pairing-address 127.0.0.1 "$@"
}

# A restart that hits serve while it starts leaves a child holding the profile lock.
# The terminal daemon is a different process and stays. Processes of nested containers are visible
# here too, so pkill and pgrep stay in the own PID namespace.
clear_previous() {
  pgrep --ns $$ --nslist pid -x orca-ide >/dev/null || return 0
  pkill --ns $$ --nslist pid -TERM -x orca-ide
  for _ in $(seq 10); do
    pgrep --ns $$ --nslist pid -x orca-ide >/dev/null || return 0
    sleep 1
  done
  pkill --ns $$ --nslist pid -KILL -x orca-ide
  pkill --ns $$ --nslist pid -TERM -f 'orcad-server\.js'
  sleep 1
}

# Device changes edit the list only while Orca is stopped, see orca-devices.
edit_devices() {
  [ -f "$RUN/devices" ] || return 0
  file=$HOME/.config/orca/orca-devices.json
  if [ -f "$file" ] && jq -e 'has("id") and (.op == "remove" or .op == "rename")' "$RUN/devices" >/dev/null 2>&1; then
    jq --slurpfile e "$RUN/devices" '$e[0] as $e
      | if $e.op == "remove" then map(select(.deviceId != $e.id))
        else map(if .deviceId == $e.id then .name = $e.name else . end) end' "$file" >"$file.new" \
      && mv "$file.new" "$file"
  fi
  rm -f "$RUN/devices"
}

while :; do
  clear_previous
  edit_devices
  if [ ! -x "$APP/current/AppRun" ]; then
    sleep 5
  elif [ -f "$RUN/pair" ]; then
    # A supervised server hides the pairing code. A short run without supervision prints it,
    # paired devices stay and terminals survive the restart.
    read -r args <"$RUN/pair" || args=""
    rm -f "$RUN/pair"
    # shellcheck disable=SC2086 # empty or a single flag from orca-pair
    serve --json $args >"$RUN/pair.part" 2>"$RUN/pair.err" &
    pid=$!
    for _ in $(seq 60); do
      grep -q 'orca://' "$RUN/pair.part" && break
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    mv "$RUN/pair.part" "$RUN/pair.json"
    orca-restart
    wait "$pid"
  else
    # Without --no-pairing every start leaves a fresh unused pairing code in the device list.
    serve --supervise --no-pairing >>"$RUN/serve.log" 2>&1
  fi
  sleep 1
done
