#!/bin/bash
# Paired devices of the Orca server.
#   orca-devices               list them
#   orca-devices remove <id>   revoke one, by its id or a unique prefix of at least 4 characters
set -euo pipefail
FILE=$HOME/.config/orca/orca-devices.json
RUN=/tmp/orca-serve

list() {
  [ -s "$FILE" ] || { echo "No paired devices."; return; }
  # Names come from the clients, so control characters are dropped before printing.
  jq -r 'if length == 0 then "No paired devices." else
      .[] | [ .deviceId[0:8],
              ((.name // "?") | gsub("[[:cntrl:]]"; "")),
              "paired " + (.pairedAt / 1000 | floor | strftime("%Y-%m-%d %H:%M UTC")),
              "last seen " + (if (.lastSeenAt // 0) > 0 then (.lastSeenAt / 1000 | floor | strftime("%Y-%m-%d %H:%M UTC")) else "never" end)
            ] | join("  ") end' "$FILE"
}

remove() {
  prefix=${1:-}
  [[ "$prefix" =~ ^[0-9a-f-]{4,}$ ]] || { echo "Give the device id from the list, at least 4 characters." >&2; exit 1; }
  ids=$(jq -r --arg p "$prefix" '.[] | select(.deviceId | startswith($p)) | .deviceId' "$FILE" 2>/dev/null || true)
  case "$(printf '%s' "$ids" | grep -c .)" in
    0) echo "No device matches '$prefix'." >&2; exit 1 ;;
    1) ;;
    *) echo "'$prefix' matches several devices, give more characters." >&2; exit 1 ;;
  esac
  # orca-serve removes it while Orca is stopped, so the running server cannot write it back.
  printf '%s\n' "$ids" >"$RUN/unpair"
  orca-restart
  for _ in $(seq 60); do
    [ -f "$RUN/unpair" ] || break
    sleep 1
  done
  if jq -e --arg id "$ids" 'any(.[]; .deviceId == $id)' "$FILE" >/dev/null; then
    echo "The device is still paired." >&2
    exit 1
  fi
  echo "Device ${ids:0:8} removed, its pairing code no longer works."
}

case "${1:-}" in
  "") list ;;
  remove) remove "${2:-}" ;;
  *) echo "Usage: orca-devices [remove <id>]" >&2; exit 1 ;;
esac
