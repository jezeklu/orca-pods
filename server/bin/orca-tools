#!/bin/bash
# Optional tools picked by PODS_TOOLS on the host. They update themselves, so they live in the
# home directory, not in the image, and survive a new image.
#   orca-tools agy
set -eu
for tool in "$@"; do
  case "$tool" in
    agy) command -v agy >/dev/null || curl -fsSL https://antigravity.google/cli/install.sh | bash ;;
    *) echo "Unknown tool '$tool', supported: agy." >&2; exit 1 ;;
  esac
done
